# REQUIRED
# Google Places API key from Google Cloud Console, must have Places API enabled (not Places (New) API)
GOOGLE_API_KEY=your_google_places_api_key
# Google Place ID from Place ID Finder
GOOGLE_PLACE_ID=your_google_place_id
# Comma-separated list of domains that are allowed to call your API
ALLOWED_ORIGINS=https://www.yourwebsite.com,https://yourwebsite.com 

# IF YOU ARE USING TRAEFIK REVERSE PROXY
# Hostname used only for Docker Compose/Traefik label substitution; the app itself does not read this value
WIDGET_HOST=reviews.yourwebsite.com 

# IF YOU ARE USING TRAEFIK + CLOUDFLARE DNS-01
# Contact email used by Traefik/Let's Encrypt ACME
ACME_EMAIL=you@example.com 
# Cloudflare DNS API token used by Traefik for DNS-01 certificate validation
CF_DNS_API_TOKEN=your_cloudflare_dns_token 

# OPTIONAL (defaults shown)
# Poll frequency
POLL_INTERVAL_MINUTES=5 
# Max reviews kept in cache
MAX_REVIEWS=50 
# Keep original review language from Google (disable auto-translated text)
DISABLE_AUTO_TRANSLATIONS=true
# Internal app port
PORT=3000 
